{
  "name": "wasalni-backend",
  "version": "1.0.0",
  "description": "Backend for Wasalni ride-sharing app",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --skipLibCheck --noEmitOnError",
    "start": "node --max-old-space-size=256 dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:watch": "tsx watch src/scripts/seed.ts"
  },
  "dependencies": {
    "express": "^4.22.2",
    "mongodb": "^6.1.0",
    "mongoose": "^7.8.10",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "multer": "^2.2.0",
    "cloudinary": "^2.11.0",
    "socket.io": "^4.7.2",
    "nodemailer": "^9.0.1",
    "joi": "^17.13.4",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/node": "^20.5.0",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.4",
    "@types/cors": "^2.8.16",
    "@types/multer": "^1.4.10",
    "@types/nodemailer": "^6.4.13",
    "tsx": "^3.13.0"
  }
}
