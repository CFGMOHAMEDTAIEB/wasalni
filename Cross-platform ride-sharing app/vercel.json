{
  "projectId": "prj_wasalni",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "@vite_api_base_url"
  },
  "envPrefix": "VITE_",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/**/*": {
      "runtime": "nodejs20.x"
    }
  }
}
